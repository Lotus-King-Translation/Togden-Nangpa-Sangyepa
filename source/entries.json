  {
    "id": "L00088",
    "index": 88,
    "context": "d0274887f7a54c389a53aee4fc41793d",
    "text": "སེམས་ཅན་ཁམས་ནི་ཚད་མེད་ལ།"
  },
  {
    "id": "L00089",
    "index": 89,
    "context": "2fe75b5b7b9c4ae9bfdeaad65a34b861",
    "text": "ཕན་འདོད་དེ་ནི་དེ་འདྲའོ།"
  },
  {
    "id": "L00090",
    "index": 90,
    "context": "16162e60c9ac46b095c65e86669152a5",
    "text": "ཞེས་གསུངས་སོ།"
  },
  {
    "id": "L00091",
    "index": 91,
    "context": "e6297bcd60a44ce9a91d0362b6254e69",
    "text": "གཉིས་པ་སྐྱབས་སུ་འགྲོ་བའི་ཚུལ་ལ། དེ་ཡང་བསྡུས་པའི་དོན་རྣམ་པ་བཅུ་སྟེ།"
  },
  {
    "id": "L00092",
    "index": 92,
    "context": "b7bee5912250423aaa226b3ebf4e338b",
    "text": "མཚན་གཞི། མཚན་ཉིད། དབྱེ་བ། ཁྱད་པར། ངོ་བོ། འབྲས་སྐྱབས་དང་སྨོན་སེམས་ཀྱི་ཁྱད་པར། དགོས་པ། སྒྲ་དོན། མཐར་ཐུག་སྐྱབ་ཡུལ་བསྒོམ་ཚུལ་ལོ།"
  },
  {
    "id": "L00093",
    "index": 93,
    "context": "e3d5e521f23e46328c3517656065d329",
    "text": "དང་པོ་མཚན་གཞི་ནི།"
  },
  {
    "id": "L00094",
    "index": 94,
    "context": "435bc4ca969b49e3934fd52fc5428004",
    "text": "སྤང་རྟོག་ཕུན་སུམ་ཚོགས་ཅིང་རང་གཞན་གྱི་དོན་གཉིས་ལྡན་པ་རྫོགས་པའི་སངས་རྒྱས།"
  },
  {
    "id": "L00095",
    "index": 95,
    "context": "7a0514daf7494d9db2c10dd4c394e45a",
    "text": "ཞི་བ་ཆགས་དང་བྲལ་བ་དམ་ཆོས།"
  },
  {
    "id": "L00096",
    "index": 96,
    "context": "60c5e43dbef644bcb4484cfbcfe010ab",
    "text": "རིག་གྲོལ་གཉིས་ལྡན་འཕགས་པའི་དགེ་འདུན་ཏེ་དཀོན་མཆོག་གསུམ་མོ།"
  },
  {
    "id": "L00097",
    "index": 97,
    "context": "d6bacecdbce94293bb4893fdb0674418",
    "text": "གཉིས་པ་མཚན་ཉིད་ནི།"
  },
  {
    "id": "L00098",
    "index": 98,
    "context": "d4bf82d80f6f421a910c14f1b791f40b",
    "text": "སངས་རྒྱས་དཀོན་མཆོག་སྐུ་བཞི་ཡེ་ཤེས་ལྔའི་བདག་ཉིད་དག་པ་གཉིས་ལྡན་མཐར་ཐུག་པ་དོན་གཉིས་ཕུན་སུམ་ཚོགས་པ་མཚན་ཉིད་བརྒྱད་ལྡན་ཡིན་ཏེ།"
  },
  {
    "id": "L00099",
    "index": 99,
    "context": "c0f326bfa7e74a15b93e1c1567101f8a",
    "text": "རྒྱལ་ཚབ་མ་ཕམ་པས།"
  },
  {
    "id": "L00100",
    "index": 100,
    "context": "3eaa2db9fcfa4f44ace6b53e414cc3e9",
    "text": "འདུས་མ་བྱས་ཤིང་ལྷུན་གྱི་གྲུབ།"
  },
  {
    "id": "L00101",
    "index": 101,
    "context": "c1721a0ab16e45a6aa51df182989fd96",
    "text": "གཞན་གྱི་རྐྱེན་གྱིས་རྟོགས་མིན་པ།"
  },
  {
    "id": "L00102",
    "index": 102,
    "context": "10a0a1aa9e0e4e80b808ec8231e809b0",
    "text": "མཁྱེན་དང་བརྩེ་དང་ནུས་པ་ལྡན།"
  },
  {
    "id": "L00103",
    "index": 103,
    "context": "4363403cf8194d7aa8cf6f69e7aee20e",
    "text": "དོན་གཉིས་ལྡན་པའི་སངས་རྒྱས་ཉིད།"
  },
  {
    "id": "L00104",
    "index": 104,
    "context": "41ab3bb0858c4757b38a6533e1d0aa55",
    "text": "ཅེས་གསུངས།"
  },
  {
    "id": "L00105",
    "index": 105,
    "context": "0442f28708e842d1acf1fe4757e87660",
    "text": "ཆོས་བརྗོད་བྱ་འགོག་པ་དང་ལམ་གྱིས་བསྡུས་པའི་ཟག་མེད་རྣམ་བྱང་གི་བདེན་པ་དང་རྗོད་བྱེད་གསུང་རབ་མིང་ཚིག་ཡི་གེར་སྣང་བ་སྟེ་ལུང་རྟོགས་གཉིས་ཀྱི་ཆོས་ལའང་མཚན་ཉིད་བརྒྱད་ལྡན་ཏེ།"
  },
  {
    "id": "L00106",
    "index": 106,
    "context": "38c388bae96d47778deb3f9620b30746",
    "text": "བསམ་མེད་གཉིས་མེད་རྟོག་མེད་པ།"
  },
  {
    "id": "L00107",
    "index": 107,
    "context": "8288df4648d24f71992473cec130ee04",
    "text": "དག་གསལ་གཉེན་པོའི་ཕྱོགས་ཉིད་ཀྱིས།"
  },
  {
    "id": "L00108",
    "index": 108,
    "context": "40e13a37d86643bb8955bc5eb60e7ddd",
    "text": "གང་ཞིག་གང་གིས་ཆགས་བྲལ་བ།"
  },
  {
    "id": "L00109",
    "index": 109,
    "context": "d0bda9d9ce59471b86b8392d6bfcb7da",
    "text": "བདེན་གཉིས་མཚན་ཉིད་ཅན་དེ་ཆོས།"
  },
  {
    "id": "L00110",
    "index": 110,
    "context": "10d12b5faee5423a9c3882efea1af7f4",
    "text": "ཞེས་གསུངས་སོ།"
  },
  {
    "id": "L00111",
    "index": 111,
    "context": "3e530fce665b495dbca60304de683aa1",
    "text": "དགེ་འདུན་དངོས་ས་ཆེན་པོ་ལ་བཞུགས་པའི་རྒྱལ་སྲས་བྱང་སེམས་འཕགས་པའི་རིག་གྲོལ་གྱི་ཡོན་ཏན་ལྡན་པ་ཉིད་དེ།"
  },
  {
    "id": "L00112",
    "index": 112,
    "context": "d8d54ce9a20143cebeb6617d75b54bf2",
    "text": "རྒྱལ་ཚབ་བྱམས་མགོན་གྱིས། ཇི་ལྟ་ཇི་སྙེད་ནང་གི་ནི།"
  },
  {
    "id": "L00113",
    "index": 113,
    "context": "4fbcc449c319418e8c38bd96288b6c0d",
    "text": "ཡེ་ཤེས་གཟིགས་པ་དག་པའི་ཕྱིར།"
  },
  {
    "id": "L00114",
    "index": 114,
    "context": "cd0cdf700694410b88dbc54bffd5a3b9",
    "text": "བློ་ལྡན་ཕྱིར་མི་ལྡོག་པའི་ཚོགས།"
  },
  {
    "id": "L00115",
    "index": 115,
    "context": "fa15471ad8d54152ac95a9d8b7e490d4",
    "text": "བླ་མེད་ཡོན་ཏན་དང་ལྡན་ཉིད།"
  },
  {
    "id": "L00116",
    "index": 116,
    "context": "eaa513da991a4d61b690e0a1435eba39",
    "text": "ཅེས་གསུངས་སོ།"
  },
  {
    "id": "L00117",
    "index": 117,
    "context": "9ec0e28ec6c64508bf97b41777c04464",
    "text": "གསུམ་པ་དབྱེ་བ་ནི། ཐུན་མོང་དང་ཐུན་མིན་གཉིས་སོ།"
  },
  {
    "id": "L00118",
    "index": 118,
    "context": "b4d50094248241cfb05d36e4123b9782",
    "text": "ཁྱེད་པར་ནི། སྐྱབས་གནས་དང། དུས། རྒྱུ། ཆེད་དུ་བྱ་བ་དད་བཞིའོ།"
  },
  {
    "id": "L00119",
    "index": 119,
    "context": "c34345b19398459184a3b8bd225ca980",
    "text": "དང་པོ་སྐྱབས་གནས་ནི།"
  },
  {
    "id": "L00120",
    "index": 120,
    "context": "4bda067eec89456695250904c9a8620e",
    "text": "ཉན་ཐོས་པ་རྣམས་ཀྱིས་འབྲས་བུ་སྐྱབས་དགྲ་བཅོམ་སྟེ།"
  },
  {
    "id": "L00121",
    "index": 121,
    "context": "0182030c1fc44b8fb7246a5d917f8094",
    "text": "སྡུག་བསྔལ་སྤངས་ནས་སངས་རྒྱས་ཀྱི་སྤྱན་སྔར་ཆོས་ཉན་གཞན་ལ་འཆད་པར་བྱེད་པ་དགེ་འདུན་དཀོན་མཆོག་ལ་འདོད་པ་ཡིན།"
  },
  {
    "id": "L00122",
    "index": 122,
    "context": "9111bf2590384a08b07b05fc65f118f8",
    "text": "རང་རྒྱལ་པ་རྣམས་ཀྱིས་རྟེན་འབྲེལ་བཅུ་གཉིས་ལུགས་འབྱུང་ལུགས་ལྡོག་གི་ཚུལ་དུ་སྒོམ་ནས་རྟེན་འབྲེལ་གྱི་ཆོས་རྣམས་ཟབ་མོར་རྟོགས་ནས་སྡུག་བསྔལ་སྤང་བའི་ཆོས་དཀོན་མཆོག་ལ་འདོད་པ་ཡིན།"
  },
  {
    "id": "L00123",
    "index": 123,
    "context": "0af6ae59af5f4800913c020499af6687",
    "text": "ཐེག་ཆེན་པོ་རྣམས་ཀྱིས་སྟོན་པ་སངས་རྒྱས་ལ་འཇིག་པ་ལས་གྲོལ་བའི་སྐྱབས་སུ་འཛིན་ཏོ།"
  },
  {
    "id": "L00124",
    "index": 124,
    "context": "75c1900af26942768afb92745c97bd8d",
    "text": "རྒྱུའི་སྐྱབས་གནས་ནི་གསུམ་ཀས་སངས་རྒྱས་ལ་སྟོན་པ། ཆོས་ལ་ལམ། དགེ་འདུན་ལ་གྲོགས་སུ་འཛིན་པ་ཡིན།"
  },
  {
    "id": "L00125",
    "index": 125,
    "context": "97c725ce361645c09d4981cbab2f1c4d",
    "text": "དུས་ནི། ཐེག་དམན་པས་ཇི་སྲིད་འཚོའི་བར་དུའོ།"
  },
  {
    "id": "L00126",
    "index": 126,
    "context": "4dc7a34e33d04a139e31895c008025f2",
    "text": "ཐེག་ཆེན་པས་སྙིང་པོ་བྱང་ཆུབ་ལ་ཐུག་གི་བར་དུའོ།"
  },
  {
    "id": "L00127",
    "index": 127,
    "context": "8c5310fca7fa4ff799ab2fe011733c73",
    "text": "རྒྱུ་ནི། ཉན་རང་གིས་རང་ཉིད་སྡུག་བསྔལ་ལས་ཐར་བར་འདོད་པ་དད་པས་སྐྱབས་སུ་འགྲོ་ལ། ཐེག་ཆེན་པས་གཞན་སེམས་ཅན་ཐམས་ཅད་སྡུག་བསྔལ་ལས་སྒྲོལ་བའི་དོན་དུ་སྙིང་རྗེ་ཆེན་པོའི་སྐྱབས་སུ་འགྲོ་བའོ།"
  },
  {
    "id": "L00128",
    "index": 128,
    "context": "df32b937679041a3baacc32932476cf3",
    "text": "ཆེད་དུ་བྱ་བ་ནི། ཉན་ཐོས་པས་རང་དང་། ཐེག་ཆེན་པའི་གཞན་སྡུག་བསྔལ་ལས་སྒྲོལ་བའི་དོན་དུ་སྐྱབས་སུ་འགྲོ་བའོ།"
  },
  {
    "id": "L00129",
    "index": 129,
    "context": "6de26bca420142ebb431d00c9f709052",
    "text": "དེ་ལ་འདིར་ཁྱད་པར་བཞི་ལྡན་གྱི་སྐྱབས་འགྲོ་ཐུན་མོང་མ་ཡིན་པ་ལ་འདོད་དོ།"
  },
  {
    "id": "L00130",
    "index": 130,
    "context": "55090c861f92410b868fd0dadda04c73",
    "text": "ངོ་བོ་ནི། འབྲས་བུ་འཇིགས་པ་མེད་པའི་གནས་སངས་རྒྱས་དོན་དུ་གཉེར་བས་སངས་རྒྱས་ཆོས་དགེ་འདུན་ལ་སྟོན་པ་ལམ་གྲོགས་སུ་ཁས་ལེན་པ་སྐྱབས་འགྲོའི་ངོ་བོ་སྟེ།"
  },
  {
    "id": "L00131",
    "index": 131,
    "context": "2fea2d5b2b36403e9f10be82ced60621",
    "text": "འབྲས་བུ་དེ་དོན་དུ་གཉེར་ཡང་སྟོན་པ་རྫོགས་པའི་སངས་རྒྱས་ལ་ཚངས་པ་དང་ལྷ་ཆེན་དབང་ཕྱུག་དང་། ཁྱབ་འཇུག་ལ་སོགས་པ་གཞན་འཛིན་པ་དང་། སངས་རྒྱས་སོགས་ལ་སྟོན་པ་ལ་སོགས་འཛིན་ཀྱང་འབྲས་བུ་དམན་པ་དོན་དུ་གཉེར་ན་སྐྱབས་སུ་ལེགས་པར་སོང་བ་མ་ཡིན་ནོ།"
  },
  {
    "id": "L00132",
    "index": 132,
    "context": "c2551c647a4b4183a0903a345183bb89",
    "text": "འབྲས་སྐྱབས་དང་སྨོན་པ་སེམས་བསྐྱེད་ལ་ཁྱད་པ་ཅི་ཡོད་ཅེ་ན། སེམས་ཅན་དོན་དུ་བྱང་ཆུབ་དོན་གཉེར་ཙམ་ནི་སྐྱབས་འགྲོ་ཡིན།"
  },
  {
    "id": "L00133",
    "index": 133,
    "context": "4c75bb7e38764a4a85635bfb51ffa329",
    "text": "བསམ་པ་དེ་ཉིད་དམ་བཅའ་བའི་ལྕགས་ཀྱུས་དབང་དུ་བྱ་བ་ནི་སྨོན་པ་སེམས་བསྐྱེད་དོ།"
  },
  {
    "id": "L00134",
    "index": 134,
    "context": "935fd22daa9347dabbe38245af79fbbb",
    "text": "དགོས་པ་ནི།"
  },
  {
    "id": "L00135",
    "index": 135,
    "context": "943bd30185f84788aac85a03ffe4bf7a",
    "text": "ཕྱི་པ་དང་ནང་པ་སངས་རྒྱས་པའི་ཁྱད་པར་དབྱེ་བའི་ཆད་དང་། དགེ་བསྙེན་དང་དགེ་ཚུལ་དགེ་སློང་སོགས་ལ་རང་རང་གི་སྡོམ་པ་སྐྱེའོ།"
  },
  {
    "id": "L00136",
    "index": 136,
    "context": "1112a0f1a2a7456a9602c2c827f3eead",
    "text": "གདོན་བགེགས་སོགས་ལས་སྐྱོབ་པའི་སྲུང་བ་ཆེན་པོ་དང་ལྡན་པ། ལོག་པར་མོས་པའི་ལས་ཀྱི་སྒྲིབ་པ་སྲབ་པ་དང་། དམ་པའི་གྲངས་སུ་བགྲང་བ་དང་། བསྟན་པ་ལ་དད་པའི་ལྷ་ཀླུ་རྣམས་ཀྱི་ཆེད་དུ་བརྗོད་པའོ།"
  },
  {
    "id": "L00137",
    "index": 137,
    "context": "64ec27d76f8b4d29b672e7ed5a0c4d0d",
    "text": "སྒྲ་དོན་ནི། རཏྣ་ཞེས་པའི་སྒྲ་ལས་རིན་པོ་ཆེ་དང་ཆོས་མཐུན་པ་དྲུག་གིས་དཀོན་མཆོག་ཏུ་བཞག་སྟེ།"
  },
  {
    "id": "L00138",
    "index": 138,
    "context": "6921763cb3304351b96013d8401a8ff6",
    "text": "རྒྱུད་བླ་མ་ལས།"
  },
  {
    "id": "L00139",
    "index": 139,
    "context": "55ad0e3752434c28b77fcb985db4e622",
    "text": "འབྱུང་བ་དཀོན་ཕྱིར་དྲི་མེད་ཕྱིར།"
  },
  {
    "id": "L00140",
    "index": 140,
    "context": "d2f0aa23a1ec4f75a423e6fa64f80152",
    "text": "མཐུ་ལྡན་ཕྱིར་དང་འཇིག་རྟེན་གྱི།"
  },
  {
    "id": "L00141",
    "index": 141,
    "context": "bca8431fcd8e4d37949dab0351430eba",
    "text": "རྒྱན་གྱུར་ཕྱིར་དང་མཆོག་ཉིད་ཕྱིར།"
  },
  {
    "id": "L00142",
    "index": 142,
    "context": "899b7bd340b64b04805b3f01fb781880",
    "text": "འགྱུར་བ་མེད་ཕྱིར་དཀོན་མཆོག་ཉིད།"
  },
  {
    "id": "L00143",
    "index": 143,
    "context": "839e2a6b6e234399be407b5d79e09801",
    "text": "ཅེས་པས།"
  },
  {
    "id": "L00144",
    "index": 144,
    "context": "edfbe25d4272482cbefea8dcf590a70c",
    "text": "འབྱུང་བ་དཀོན་པར་ཆོས་མཐུན་པ་ནི། བསྐལ་པ་ཡོངས་སུ་འགྱུར་བ་མང་པོར་ཡང་འཇིག་རྟེན་ན་དགེ་བའི་རྩ་བ་མ་བསྐྲུན་པའི་སེམས་ཅན་རྣམས་དང་འཕྲད་པར་མི་འགྱུར་བའི་ཕྱིར་རོ།"
  },
  {
    "id": "L00145",
    "index": 145,
    "context": "7dc0e3f1dbee471bb6cba1a65f2704ab",
    "text": "དྲི་མ་མེད་པར་ཆོས་མཐུན་པ་ནི། རྣམ་པ་ཐམས་ཅད་དུ་སྐྱོན་གྱི་དྲི་མ་ཐམས་ཅད་དང་བྲལ་བའི་ཕྱིར་རོ།"
  },
  {
    "id": "L00146",
    "index": 146,
    "context": "8c56a859da8f42ad96e70dca53836240",
    "text": "མཐུ་དང་ལྡན་པར་ཆོས་མཐུན་པ་ནི། མངོན་པར་ཤེས་པ་དྲུག་ལ་སོགས་པའི་ཡོན་ཏན་གྱི་མཐུ་བསམ་གྱི་མི་ཁྱབ་པ་དང་ལྡན་པས་འཇིག་རྟེན་གྱི་རྒུད་པ་སེལ་བའི་ཕྱིར་རོ།"
  },
  {
    "id": "L00147",
    "index": 147,
    "context": "8d0fb21c4b044ab697c32bba9b13a514",
    "text": "འཇིག་རྟེན་གྱི་རྒྱན་དུ་གྱུར་པར་ཆོས་མཐུན་པ་ནི། འགྲོ་བ་ཐམས་ཅད་ཀྱི་བསམ་པ་དགེ་བའི་རྒྱི་ཡིན་པའི་ཕྱིར།"
  },
  {
    "id": "L00148",
    "index": 148,
    "context": "729cccd23a4d4561bc71732c1d753a63",
    "text": "རིན་པོ་ཆེ་བཅོས་མ་ལས་མཆོག་ཉིད་དུ་ཆོས་མཐུན་པ་ནི། འཇིག་རྟེན་ལས་འདས་པའི་ཡོན་ཏན་མངའ་བའི་ཕྱིར་རོ།"
  },
  {
    "id": "L00149",
    "index": 149,
    "context": "64d297fef76849cc908f1882452d07c7",
    "text": "བསྟོད་སྨད་ལ་སོགས་པའི་རྐྱེན་གྱིས་འགྱུར་བ་མེད་པར་ཆོས་མཐུན་པ་ནི། ཆོས་ཉིད་འདུས་མ་བྱས་པའི་རང་བཞིན་ཡིན་པའི་ཕྱིར་རོ།"
  },
  {
    "id": "L00150",
    "index": 150,
    "context": "d0f9a155bc4e4ff6ab72e7690779e497",
    "text": "མཐར་ཐུག་སྐྱབས་ཡུལ། མཐར་ཐུག་གི་སྐྱབས་གནས་སངས་རྒྱས་ཁོ་ན་ཡིན་གྱི། གཞན་གཉིས་མ་ཡིན་ཏེ། ལུང་གི་ཆོས་རྣམས་བདེན་པ་མཐོང་བ་ན་སྤང་དགོས་པའི་ཕྱིར་དང་། བྱང་སེམས་ཉན་རང་གི་རྒྱུད་ཀྱི་རྟོགས་པའི་ཆོས་རྣམས་གོང་ནས་གོང་བོཌ་དབྱུང་དུ་ཡོད་པས་མི་རྟག་ཅིང་བསླུ་བའི་ཕྱིར་དང་། དགེ་འདུན་དེ་དག་རང་ཡང་ད་དུང་ལམ་བགྲོད་བྱ་དང་བཅས་པས་ན་མཐར་ཐུག་པ་མེད་པའི་ཕྱིར་དང་། བག་ལ་ཉལ་བ་དང་རང་སའི་སྒྲིབ་པ་རྣམས་སངས་རྒྱས་ལ་མ་བརྟེན་པར་སྤང་མི་ནུས་པས་ན་འཇིགས་པ་དང་བཅས་པའི་ཕྱིར་ཏེ།"
  },
  {
    "id": "L00151",
    "index": 151,
    "context": "6ec1abfd2ca84871a3dec31123e4202d",
    "text": "རྒྱུས་བླ་མ་ལས།"
  },
  {
    "id": "L00152",
    "index": 152,
    "context": "475b7c8aac444c44a575b0010f7288d9",
    "text": "སྤང་ཕྱིར་བསླུ་བའི་ཆོས་ཅན་ཕྱིར།"
  },
  {
    "id": "L00153",
    "index": 153,
    "context": "e944c054f28e4eb9a6c1b43eb34883b8",
    "text": "མེད་ཕྱིར་འཇིགས་དང་བཅས་པའི་ཕྱིར།"
  },
  {
    "id": "L00154",
    "index": 154,
    "context": "6bf62cec91f2416eaf04c59bfb3638f1",
    "text": "ཆོས་རྣམས་གཉིས་དང་འཕགས་པའི་ཚོགས།"
  },
  {
    "id": "L00155",
    "index": 155,
    "context": "494e271d00cd4ce5aed762050b9b36ec",
    "text": "གཏན་གྱི་སྐྱབས་མཆོག་མ་ཡིན་ནོ།"
  },
  {
    "id": "L00156",
    "index": 156,
    "context": "ce0c45a33496489eaa36b8984d3bfd40",
    "text": "དམ་པའི་དོན་དུ་འགྲོ་བ་ཡིན།"
  },
  {
    "id": "L00157",
    "index": 157,
    "context": "d6fc1d223fb4458980b3beee96bf5964",
    "text": "སྐྱབས་ནི་སངས་རྒྱས་ཉག་གཅིག་ཡིན།"
  },
  {
    "id": "L00158",
    "index": 158,
    "context": "0a43f57304a349568e6ebf34c7bc34dc",
    "text": "ཞེས་སོ།"
  },
  {
    "id": "L00159",
    "index": 159,
    "context": "400f256f27a442bcb07ad11d6b8fbf26",
    "text": "བདུན་པ་བསྒོམ་ཚུལ་ནི། དུས་དང་རྣམ་པ་ཐམས་ཅད་དུ་སེམས་དྲན་ཤེས་དང་མ་བྲལ་བའི་ངང་ནས་སྐྱབས་གནས་གསུམ་པོ་དང་ལྷ་ཚོགས་དེ་དག་འགྲོ་བའི་ཚེ་ཕྲག་པ་གཡས་ཀྱི་ནམ་མཁར་བསྒོམ།"
  },
  {
    "id": "L00160",
    "index": 160,
    "context": "ebf8ffc090044557afa69f1890491818",
    "text": "དེ་བསྐོར་བ་བྱེད་པའི་གནས་ཡིན།"
  },
  {
    "id": "L00161",
    "index": 161,
    "context": "9bff1397547447aab2d7033fc5cae8c6",
    "text": "འདུག་པའི་དུས་སྤྱི་བོའི་གཙུག་གི་ནམ་མཁར་བསྒོམ།"
  },
  {
    "id": "L00162",
    "index": 162,
    "context": "2d5b9ae264884bc987b98f9827508e3e",
    "text": "དེ་གསོལ་བ་འདེབས་པའི་རྟེན་ཡིན།"
  },
  {
    "id": "L00163",
    "index": 163,
    "context": "05686a071a7d4eefbc0b4f7fc719ff0f",
    "text": "ཟ་འཐུང་གི་དུས་མགྲིན་པའི་དབུས་སུ་བསྒོམ།"
  },
  {
    "id": "L00164",
    "index": 164,
    "context": "4792ef9b6b334c5b93ceef190f86b4c1",
    "text": "དེ་ཅི་ཟ་ཅི་འཐུང་གི་ཕུད་མཆོད་ས་ཡིན།"
  },
  {
    "id": "L00165",
    "index": 165,
    "context": "e6b1d69d3fde42258194ed460e6f6268",
    "text": "གཉིད་ལོག་པའི་དུས་སྙིང་གི་དབུས་སུ་བསྒོམ།"
  },
  {
    "id": "L00166",
    "index": 166,
    "context": "b88114a234fe4cb8b235e10d55b41215",
    "text": "དེ་འཁྲུལ་བ་འོད་གསལ་དུ་སྦ་བའི་གནད་ཡིན།"
  },
  {
    "id": "L00167",
    "index": 167,
    "context": "fc30d3ddc6584c48b4c691176897c1ff",
    "text": "དེ་ལྟར་སྤྱོད་ལམ་ཐམས་ཅད་དུ་སྐྱབས་ཡུལ་རྣམས་གསལ་སྣང་དང་མ་བྲལ་བའི་ངང་ནས་དཀོན་མཆོག་རིན་པོ་ཆེ་རྣམ་པ་གསུམ་ལ་ཡིད་ཁྱེད་ཤེས་ཀྱི་དད་པས་བློ་བཀལ་ཏེ་སྐྱབས་འགྲོ་མཛད་དགོས་ཁག་ཆེའོ།"
  },
  {
    "id": "L00168",
    "index": 168,
    "context": "4824d1bad89a4c1ea22c052705da2432",
    "text": "གསུམ་པ་བསླབ་བྱ་བསྟན་པ་ལ། ཕྱག་འཚལ་བའི་བསླབ་བྱ། སྤང་བྱའི་བསླབ་བྱ། བསྒྲུབ་བྱའི་བསླབ་བྱ། ཆ་མཐུན་གྱི་བསླབ་བྱ་དང་བཞིའོ།"
  },
  {
    "id": "L00169",
    "index": 169,
    "context": "760f11f1db8f47ee8becf4fea682ca2d",
    "text": "དང་པོ་ནི། དེ་ཡང་ཕྱག་འཚལ་བའི་དུས་ལུས་ཀྱི་སྒོ་ནས་ཕྱག་འཚལ་བ། ངག་གིས་སྐྱབས་འགྲོ་དང་གསོལ་འདེབས་གང་ཤེས་ཀྱི་ཚིག་འདོན་པ། ཡིད་ཀྱིས་ཅི་མཛད་ཁྱེད་ཤེས་ཀྱི་བློ་གཏད་བརྟན་པོ་དང་མོས་པ་ཁག་ཆེ་མཛད་དགོས།"
  },
  {
    "id": "L00170",
    "index": 170,
    "context": "8bea1c19b0374aa9bc31adba516ebfa7",
    "text": "དེ་ལྟར་སྒོ་གསུམ་ཁྱོན་ཅིག་ཏུ་བསྒྲིམས་ནས་བདག་དང་སེམས་ཅན་ཐམས་ཅད་ལྷན་ཅིག་ཕྱག་འཚལ་བའི་དམིགས་པ་སོགས་གནད་ཆེ་ལ།"
  },
  {
    "id": "L00171",
    "index": 171,
    "context": "a2dc8d08cf754c39b3457cfe86dae9d8",
    "text": "དེ་ལྟར་མ་ཡིན་པར་ཁ་གཡེང་མིག་གཡེང་སེམས་ཕྱི་རོལ་གྱི་ཡུལ་གྱི་རྗེས་སུ་འབྲངས།"
  },
  {
    "id": "L00172",
    "index": 172,
    "context": "49f7848a8b7540dd8820f3eb471def5b",
    "text": "གཡས་ཕྱོགས་ནས་འགྲོ་འདུག་དང་སྨྲ་བརྗོད་ཟེར་བ་བྱུང་ན་མིག་དང་ཤེས་པ་དེ་ཕྱོགས་སུ་གཡེང་ཞིང་ཐལ་མོ་འགྲམ་པ་གཡོན་གྱི་སྟེང་དུ་སྦྱར།"
  },
  {
    "id": "L00173",
    "index": 173,
    "context": "2dd6cf54fc9546b2b62c32670f54be7e",
    "text": "དེ་བཞིན་དུ་གཡོན་ཕྱོགས་སུའང་འདྲ།"
  },
  {
    "id": "L00174",
    "index": 174,
    "context": "b29184b4b5e94d089e78956ae3e599dd",
    "text": "སེམས་རྣམ་གཡེང་གི་དབང་དུ་བཏང་།"
  },
  {
    "id": "L00175",
    "index": 175,
    "context": "081230456078410b99105c4a0150e112",
    "text": "ལུས་དེ་ཁོ་ནས་ཁྱོ་རོ་རོ་ཕྱག་འཚལ་མདོགས་བྱེད་པ་ནི་སྙིང་པོ་ཅི་ཡང་མེད་འོ་རྒྱལ་ཆེ་བའི་རྒྱུའོ།"
  },
  {
    "id": "L00176",
    "index": 176,
    "context": "89e1251466cb4211b99a9d80c0ed1415",
    "text": "སྐྱོབ་པ་འཇིག་རྟེན་གསུམ་མགོན་གྱིས།"
  },
  {
    "id": "L00177",
    "index": 177,
    "context": "382f2834dd33483fad757b166b2d14b3",
    "text": "བླ་མ་དང་རང་སེམས་སངས་རྒྱས་གསུམ།"
  },
  {
    "id": "L00178",
    "index": 178,
    "context": "e62e5e945a164089a7119407679836cd",
    "text": "ཅིག་ཏུ་རྟོགས་པའི་རྣལ་འབྱོར་ལ།"
  },
  {
    "id": "L00179",
    "index": 179,
    "context": "dda94c122b064f5ba521bc8a76c3252f",
    "text": "བཅོས་མ་མོས་གུས་བྱ་རྒྱུ་མེད།"
  },
  {
    "id": "L00180",
    "index": 180,
    "context": "4e289e13cc574e3db62fc0a3cdf98755",
    "text": "ཞེས་གསུངས་པ་ལྟར་ཡིན།"
  },
  {
    "id": "L00181",
    "index": 181,
    "context": "935238279130474e979ec93d8fd130ac",
    "text": "དེར་མ་ཟད་ཕྱག་འཚལ་ཚེ་ཡང་ཐལ་མོ་ཁོག་སྟོང་དུ་པདྨ་ཁ་འབུས་པ་ལྟ་བུར་སྦྱར་དགོས་ཀྱི། ཐལ་མོ་ལ་ནང་ཁོང་སྟོང་མེད་པར་ལག་མཐིལ་གཉིས་སྤྲད་དེ་བཅའ་བ་ནི་མུ་སྟེགས་པའི་ཕྱག་ཡིན།"
  },
  {
    "id": "L00182",
    "index": 182,
    "context": "e0524703910249739736d0e8d05d9c7a",
    "text": "སོར་རྩེ་ཐུག་ཙམ་བྱེད་པ་ནི་བླུན་པོ་ཅང་མི་ཤེས་ཀྱི་ཕྱག་ཡིན་དེ་རྣམས་མི་རུང་སྟེ།"
  },
  {
    "id": "L00183",
    "index": 183,
    "context": "3908531c187c4cf295775348aa4b3172",
    "text": "ཐར་པ་ཆེན་པོ་ཕྱོགས་སུ་རྒྱས་པའི་མདོ་ལས།"
  },
  {
    "id": "L00184",
    "index": 184,
    "context": "73efeb0c353147788f96f169f06ed06a",
    "text": "པདྨ་ཁ་འབུས་ཕྱེས་འདྲ་བ།"
  },
  {
    "id": "L00185",
    "index": 185,
    "context": "fe501f9252994cc0bea413b15f940e54",
    "text": "ལག་གཉིས་སྤྱི་བོར་ཐལ་སྦྱར་ཏེ།"
  },
  {
    "id": "L00186",
    "index": 186,
    "context": "78e15f2ed2ef4ffbbce0c336b6c03939",
    "text": "ལུས་དཔག་མེད་པའི་སྤྲིན་ཚོགས་བཅས།"
  },
  {
    "id": "L00187",
    "index": 187,
    "context": "64ba1dc0bce84f46a8a5c69dd73fadd9",
    "text": "ཕྱོགས་བཅུའི་སངས་རྒྱས་ལ་ཕྱག་འཚལ།"
  },
  {
    "id": "L00188",
    "index": 188,
    "context": "60acf7bf39334d029614036a769e2294",
    "text": "ཞེས་དང་།"
  },
  {
    "id": "L00189",
    "index": 189,
    "context": "d902acb34ae64f92aa95876bb9c796f3",
    "text": "དེ་ནས་རིམ་བཞིན་ཐལ་མོ་སྤྱི་བོར་སྦྱར་བས་ལུས་ཀྱི་སྒྲིབ་པ་འདག"
  },
  {
    "id": "L00190",
    "index": 190,
    "context": "9cacaef570d64c96b461a1b461951a44",
    "text": "མགྲིན་པར་སྦྱར་བས་ངག་གི་སྒྲིབ་པ་འདག"
  },
  {
    "id": "L00191",
    "index": 191,
    "context": "4c863fbacc5b4c3881072d8b4363eb0f",
    "text": "སྙིང གར་སྦྱར་བས་ཡིད་ཀྱི་སྒྲིབ་པ་འདག"
  },
  {
    "id": "L00192",
    "index": 192,
    "context": "279f6fa91cce4dc4a5dcd970ff4ab1a4",
    "text": "དེ་ནས་ལུས་ཀྱི་མ་ལྔ་ས་ལ་ཕབ་པ་ཞེས་བྱ་བ། དཔྲལ་བ་དང་གཅིག ལག་མཐིལ་གཉིས། པུས་མོ་གཉིས་དང་ལྔ་པོས་ལ་ཕབ་སྟེ་ཕྱག་བྱས་པས། ཉོན་མོངས་པ་དུག་ལྔའི་སྒྲིབ་པ་འདག་པ་དང་།"
  },
  {
    "id": "L00193",
    "index": 193,
    "context": "a150db4969e544e4b8a5ff901b1edb4f",
    "text": "སྐུ་གསུངས་ཐུགས་ཡོན་ཏན་ཕྲིན་ལས་ལྔའི་བྱིན་རླབས་ཐོབ་པ་ལ་སོགས་པའི་དགོས་པ་ཡོད་པས་དེ་ལྟར་བྱ།"
  },
  {
    "id": "L00194",
    "index": 194,
    "context": "63cd4255228c47829c77437bad84cbcb",
    "text": "དེ་ནས་ཡར་ལ་ངས་པའི་ཡང་རྐེད་པ་དྲང་པོར་བསྲངས་ཏེ་ཐལ་མོ་བཅས་ནས་ཡང་སྔར་ལྟར་ཕྱག་འཚལ་མཛད་དགོས་པ་ཡིན་ནོ།"
  },
  {
    "id": "L00195",
    "index": 195,
    "context": "f5c8f19056304539b34a8134fc0ca235",
    "text": "གཉིས་པ། སྤང་བྱ་གསུམ་ནི། སངས་རྒྱས་ལ་སྐྱབས་སུ་སོང་ནས་འཁོར་བའི་ལྷ་ལ་ཕྱག་མི་འཚལ་ཞེས་བྱ་སྟེ།"
  },
  {
    "id": "L00196",
    "index": 196,
    "context": "5dfe7f14b3ad4c97aab860a1b0f8748c",
    "text": "ཕྱི་རོལ་མུ་སྟེགས་པའི་ལྷ་དབང་ཕྱུགས་དང་ཁྱབ་འཇུག་ལ་སོགས་རང་ཉིད་འཁོར་བའི་སྡུག་བསྔལ་ལས་མ་གྲོལ་བ་རྣམས་དང་།"
  },
  {
    "id": "L00197",
    "index": 197,
    "context": "de8b344010f34106b461cf7ba6bdbc1c",
    "text": "གཞན་ཡང་ཡུལ་ལྷ་གཞི་བདག་ལ་སོགས་པ་འཇིག་རྟེན་གྱི་ལྷ་འདྲེ་མཐུ་བོ་ཆེ་རྣམས་ལ་ཕྱི་མའི་སྐྱབས་གནས་སུ་བཟུང་ནས་ཕྱག་དང་མཆོད་པ་ལ་སོགས་མི་བྱ།"
  },
  {
    "id": "L00198",
    "index": 198,
    "context": "a945cf7518504989b9af1bab6b82edeb",
    "text": "ཆོས་ལ་སྐྱབས་སུ་སོང་ནས་སེམས་ཅན་ལ་འཚེ་བ་སྤང་ཞེས་གསུངས་ཏེ།"
  },
  {
    "id": "L00199",
    "index": 199,
    "context": "61fcc8e158534ef687ed1048fb51e6f3",
    "text": "སེམས་ཅན་གཞན་ལ་གནོད་ཅིང་འཚེ་བའི་བྱ་བ་རྨི་ལམ་དུ་ཡང་མི་བྱ་བར་འབད་པ་དྲག་པོས་ཅི་ནུས་སུ་བསྲུང་།"
  },
  {
    "id": "L00200",
    "index": 200,
    "context": "8091ee91b2794f0b82a680d0704ebe14",
    "text": "དགེ་འདུན་ལ་སྐྱབས་སུ་སོང་ནས་གྲོགས་མུ་སྟེགས་ཅན་དད་མི་འགྲོགས་ཏེ།"
  },
  {
    "id": "L00201",
    "index": 201,
    "context": "9835178185c542e5847e4edf347b17c4",
    "text": "རད་གི་བླ་མ་དང་ཆོས་ལ་གཤེ་ཞིང་སྨོད་པ་དང་གསང་སྔགས་ཟབ་མོའི་ཆོས་ལ་སྐུར་འདེབས་བྱེད་པ་མུ་སྟེགས་དང་ཆ་འདྲ་བ་ལ་མི་འགྲོགས།"
  },
  {
    "id": "L00202",
    "index": 202,
    "context": "c71fc8b22b8242548c19eb59edfa75a3",
    "text": "བསྒྲུབ་བྱ་གསུམ་ནི།"
  },
  {
    "id": "L00203",
    "index": 203,
    "context": "1f99bdb231d944c5be7b1f96e1d1bef5",
    "text": "སངས་རྒྱས་ལ་སྐྱབས་སུ་སོང་ནས་སངས་རྒྱས་དཀོན་མཆོག་གི་སྐུའི་རྟེན་ཆག་དུམ་ཡན་ཆད་གུས་པས་མཆོད།"
  },
  {
    "id": "L00204",
    "index": 204,
    "context": "3c87fe8d2a0e4385bd790a7d11b6278b",
    "text": "སྤྱི་བོས་བཏེག་གཙང་སར་བཞག"
  },
  {
    "id": "L00205",
    "index": 205,
    "context": "6e9cd94b851a481a89c2c80170ce20e3",
    "text": "སངས་རྒྱས་དཀོན་མཆོག་དངོས་ཀྱི་འདུ་ཤེས་བསྐྱེད་དེ་དད་པ་དང་ངག་སྣང་བྱ།"
  },
  {
    "id": "L00206",
    "index": 206,
    "context": "789281cc576d4bd3969b3f98ea226795",
    "text": "ཆོས་ལ་སྐྱབས་སུ་སོང་ནས་གསུང་རབ་ཡི་གེ་ཀ་ཁ་ན་ཡན་ཆད་གུས་པ་བསྐྱེད།"
  },
  {
    "id": "L00207",
    "index": 207,
    "context": "43506ba53a87423194e4ef5660305231",
    "text": "སྤྱི་བོས་བཏེག་ཆོས་དཀོན་མཆོག་དངོས་ཀྱི་འདུ་ཤེས་བཞག་དགེ་འདུན་ལ་སྐྱབས་སུ་སོང་ནས་དགེ་འདུན་དཀོན་མཆོག་གོ་རྟེན་ལྷན་པ་དམར་སེར་ཡན་ཆད་དགེ་འདུན་དངོས་ཀྱི་འདུ་ཤེས་བཞག་ནས་གུས་པས་མཆོད།"
  },
  {
    "id": "L00208",
    "index": 208,
    "context": "42c5eaf4f52640a78f4f443056c309a3",
    "text": "སྤྱི་བོས་མཆོད་གཙང་སར་བཞག་དད་པ་དང་དག་སྣང་བྱ།"
  },
  {
    "id": "L00209",
    "index": 209,
    "context": "36d36cb68a07498bb9a04d8b86fa21e7",
    "text": "ཁྱད་པར་གསང་སྔགས་རྡོ་རྗེ་ཐེག་པ་འདིར་སྐྱབས་ཡུལ་གྱི་གཙོ་བོ་བླ་མ་ཡིན་པས། བླ་མའི་སྐུ་དགེ་འདུན། གསུང་དམ་ཆོས། ཐུགས་སངས་རྒྱས་ཏེ་དཀོན་མཆོག་ཀུན་འདུས་ཀྱི་ངོ་བོར་ཤེས་པར་བྱས་ནས། ཅི་མཛད་ལེགས་མཐོང་དང་། བློ་གཏད་ཁྱེད་ཤེས་ཀྱི་སྒོ་ནས་བསྟེན་ཞིང་རྟག་ཏུ་སྔ་དྲོ་ལན་གསུམ་མམ་བདུན། ཕྱི་ཏོག་ཡང་དེ་བཞིན་ཕྱག་འཚལ་སྐྱབས་འགྲོ་གསུང་དགོས།"
  },
  {
    "id": "L00210",
    "index": 210,
    "context": "60bc0896383045e2a7c3cd43f2aa6bf8",
    "text": "བླ་མ་ལ་སྐྱབས་སུ་མཆིའོ།"
  },
  {
    "id": "L00211",
    "index": 211,
    "context": "054e40d0e34b43a0a6283b1bd64b4a43",
    "text": "སངས་རྒྱས་ལ་སྐྱབས་སུ་མཆིའོ།"
  },
  {
    "id": "L00212",
    "index": 212,
    "context": "a91b6e5c58cb4e348ee334688eea2a78",
    "text": "ཆོས་ལ་སྐྱབས་སུ་མཆིའོ།"
  },
  {
    "id": "L00213",
    "index": 213,
    "context": "3d6492a48fd34204ac7070329e004f03",
    "text": "དགེ་འདུན་ལ་སྐྱབས་སུ་མཆིའོ།"
  },
  {
    "id": "L00214",
    "index": 214,
    "context": "1f42d26d6f584b4ba0aed9ab70cd2393",
    "text": "དཔའ་བོ་མཁའ་འགྲོ་ཆོས་སྐྱོང་སྲུང་མའི་ཚོགས་ཡེ་ཤེས་ཀྱི་སྤྱན་དང་ལྡན་པ་རྣམས་ལ་སྐྱབས་སུ་མཆིའོ།"
  },
  {
    "id": "L00215",
    "index": 215,
    "context": "11008c7a90774721966a31d0c20686ca",
    "text": "སངས་རྒྱས་ཆོས་དང་ཚོགས་ཀྱི་མཆོག་རྣམས་ལ།"
  },
  {
    "id": "L00216",
    "index": 216,
    "context": "8f0c9c1574c243e393a2ade72f2c92ad",
    "text": "བྱང་ཆུབ་བར་དུ་བདག་ནི་སྐྱབས་སུ་མཆིའོ།"
  },
  {
    "id": "L00217",
    "index": 217,
    "context": "55f11454aaa0499992775010400bc958",
    "text": "བདག་གིས་སྦྱིན་སོགས་བགྱིས་པའི་བསོད་ནམས་ཀྱིས།"
  },
  {
    "id": "L00218",
    "index": 218,
    "context": "17d5b074a37941179d393960038735ae",
    "text": "འགྲོ་ལ་ཕན་ཕྱིར་སངས་རྒྱས་འགྲུབ་པར་ཤོག"
  },
  {
    "id": "L00219",
    "index": 219,
    "context": "a116dcb976d840f79018a6a0e170b361",
    "text": "ཞེས་སྐྱབས་འགྲོ་བཞི་སྐོར་དུ་གྲགས་པ་འདི་དག་ལ་ཡི་དམ་དུ་བྱ།"
  },
  {
    "id": "L00220",
    "index": 220,
    "context": "5c7482af660f4c0caa258f086eed148d",
    "text": "ཆ་མཐུན་གསུམ་ནི།"
  },
  {
    "id": "L00221",
    "index": 221,
    "context": "1dce373525744b94917e69c5063349c6",
    "text": "ད་ལྟ་རང་ལ་བླང་དོར་གྱི་གནས་སྟོན་པའི་བླ་མ་དགེ་བའི་བཤེས་གཉེན་ལ། སངས་རྒྱས་དཀོམ་མཆོག་དདོས་ཀྱི་འདུ་ཤེས་བཞག་ནས་ཐ་ན་སྐུའི་གྲིབ་མ་ཙམ་ལ་ཡང་མི་འགོང་་བར་ཞབས་ཏོག་དང་བསྙེན་བཀུར་ལ་འབད།"
  },
  {
    "id": "L00222",
    "index": 222,
    "context": "11a65712a0854985bab59a344a26d981",
    "text": "བླ་མ་དམ་པ་དེས་བཀའ་ཇི་ལྟར་སྩལ་བའི་གསུང་རྣམས་ལ་ཆོས་དཀོན་མཆོག་དངོས་ཀྱི་འདུ་ཤེས་བཞག་ནས་ཅི་གསུངས་དང་དུ་བླང་ཞིང་གསུང་གི་ཟུར་ཙམ་ཡང་མི་བཅག"
  },
  {
    "id": "L00223",
    "index": 223,
    "context": "1f836e5302a74c7ca7ec5dea4139f715",
    "text": "བླ་མའི་འཁོར་དང་སློབ་མ་རང་གི་གྲོགས་ཚངས་པར་མཚུངས་པར་སྤྱོད་པ་རྣམས་ལ་དགེ་འདུན་དཀོན་མཆོག་དངོས་ཀྱི་འདུ་ཤེས་བཞག་སྟེ་ལུས་ངག་ཡིད་གསུམ་གུས་པས་བསྟེན་ཞིང་མི་མཉེས་པ་སྐད་ཅིག་མ་ཙམ་ཡང་མི་བྱའོ།"
  },
  {
    "id": "L00224",
    "index": 224,
    "context": "47b4c44a9de849f584a77568089a93dc",
    "text": "ཇོ་བོ་རྗེ་དཔལ་ལྡན་ཨ་ཏི་ཤ་ཡང་མདོ་སྔགས་ཀྱི་ཆོས་རྒྱ་མཚོ་ལྟ་བུ་ལ་མི་མཁྱེན་པ་དང་མི་གཟིགས་པ་ཅུང་ཟད་མེད་ཀྱང་། དེ་དག་ཀུན་ཀྱང་ཐོག་མར་སྐྱབས་འགྲོ་ཁོ་ན་གནད་ཆེ་བར་འདུག་གསུངས་ནས་སྐྱབས་འགྲོ་་་་བཤད་པས་སྐྱབས་འགྲོ་པཎྜི་ཏ་ཞེས་གྲགས་སོ།"
  },
  {
    "id": "L00225",
    "index": 225,
    "context": "35b5ee20a8dc4596a6c2a2d292f3bc46",
    "text": "དེས་ན་ཐར་པའི་ལམ་དུ་ཞུགས་པའི་ནང་པ་སངས་རྒྱས་པ་ཞིག་ཡིན་ཕྱིན་ཆད་སྐྱབས་འགྲོ་དང་སྐྱབས་འགྲོའི་བསླབ་བྱ་སྲོག་ལ་བབས་ཀྱང་མི་དོར་བར་ཉམས་སུ་བླང་དགོས་ཏེ།"
  },
  {
    "id": "L00226",
    "index": 226,
    "context": "492288ce99d4446d9408cb001f513d3a",
    "text": "མདོ་ལས།"
  },
  {
    "id": "L00227",
    "index": 227,
    "context": "b3970bacfe814841834ae8fa37597a61",
    "text": "གང་ཞིག་སངས་རྒྱས་སྐྱབས་འགྲོ་བ།"
  },
  {
    "id": "L00228",
    "index": 228,
    "context": "feeeb2a8acd042adbb99c9806f7d03ab",
    "text": "དེ་ནི་ཡང་དག་དགེ་བསྙེན་ཏེ།"
  },
  {
    "id": "L00229",
    "index": 229,
    "context": "00228416c1ff4b9eb080bc30235e831b",
    "text": "ནམ་དུ་ལྷ་ནི་གཞན་དག་ལ།"
  },
  {
    "id": "L00230",
    "index": 230,
    "context": "8782079134c540808acb82e2510e19cb",
    "text": "སྐྱབས་སུ་སོང་བ་མ་ཡིན་ནོ།"
  },
  {
    "id": "L00231",
    "index": 231,
    "context": "11afc20202ce4841a7310b63f3dd1404",
    "text": "དམ་པའི་ཆོས་ལ་སྐྱབས་འགྲོ་བ།"
  },
  {
    "id": "L00232",
    "index": 232,
    "context": "94c129c2a91a4040bce0705b2cfddefc",
    "text": "འཚེ་ཞིང་གནོད་པའི་སེམས་དང་བྲལ།"
  },
  {
    "id": "L00233",
    "index": 233,
    "context": "39aa25ccf45146c2989c6082f584db57",
    "text": "འཕགས་པའི་དགེ་འདུན་་སྐྱབས་འགྲོ་བ།"
  },
  {
    "id": "L00234",
    "index": 234,
    "context": "2896ebd40e754a6cb38e0c6a18d2e1f2",
    "text": "མུ་སྟེགས་ཅན་དང་འགྲོགས་མི་བྱ།"
  },
  {
    "id": "L00235",
    "index": 235,
    "context": "57dd7b1372a1458ba3ffc05ff3cb4ae2",
    "text": "ཞེས་སོགས་གསུངས་པ་ལྟར་རོ།"
  },
  {
    "id": "L00236",
    "index": 236,
    "context": "9a6ef296083f4e12bb8b52e8b590d518",
    "text": "བཞི་པ་སྐྱབས་སུ་སོང་བའི་ཕན་ཡོན་བསྟན་པ་ནི།"
  },
  {
    "id": "L00237",
    "index": 237,
    "context": "d6a26bf4587c42509b368fb5076db737",
    "text": "གང་གི་སྐྱབས་སུ་སོང་བ་ཙམ་གྱིས་ཐར་པའི་ས་བོན་འདེབས་པ་དང་།"
  },
  {
    "id": "L00238",
    "index": 238,
    "context": "b739e88e4a6842f390bf623786a7ce9c",
    "text": "མི་དགེ་བའི་ཚོགས་ལས་རིང་དུ་བྱེད་པ་དང་།"
  },
  {
    "id": "L00239",
    "index": 239,
    "context": "db393da13c024624b1353c3917e31f7a",
    "text": "དགེ་བ་གོང་དུ་འཕེལ་བ་དང་།"
  },
  {
    "id": "L00240",
    "index": 240,
    "context": "ef4f4f3ac336498da6c36d80f9b6debe",
    "text": "སྡོམ་པ་ཀུན་གྱི་རྟེན་གཞིར་འགྱུར་ཞིང་། ཡོན་ཏན་ཐམས་ཅད་ཀྱི་འབྱུང་གནས་སུ་འགྱུར་བ་དང་།"
  },
  {
    "id": "L00241",
    "index": 241,
    "context": "720063733ebb4ef39b53b9869f3c023f",
    "text": "གནས་སྐབས་སུ་ཡང་དཀར་ཕྱོགས་ལྷ་རྣམས་ཀྱིས་སྲུང་ཞིང་བསམ་དོན་འགྲུབ་པ་དང་།"
  },
  {
    "id": "L00242",
    "index": 242,
    "context": "a03604d584b6456194d9d32e30c42c84",
    "text": "མཐར་ཐུགས་སངས་རྒྱས་ཀྱི་གོ་འཕང་ཐོབ་པ་ལ་སོགས་ཕན་ཡོན་དཔག་ཏུ་མེད་པར་གསུངས་ཏེ།"
  },
  {
    "id": "L00243",
    "index": 243,
    "context": "159bc4a0481445df91bbb03588ccc67d",
    "text": "ཕར་ཕྱིན་བསྡུས་པ་ལས།"
  },
  {
    "id": "L00244",
    "index": 244,
    "context": "f1b5de4914f141ee8d6f5664b702d856",
    "text": "སྐྱབས་སོང་བསོད་ནམས་གཟུགས་མཆིས་ན།"
  },
  {
    "id": "L00245",
    "index": 245,
    "context": "181e911a42804fd0b212ff4a6739a741",
    "text": "ཁམས་གསུམ་འདི་ཡང་སྣོད་དུ་ཆུང་།"
  },
  {
    "id": "L00246",
    "index": 246,
    "context": "e3eb808985534d5fa9fcccb6fb94cc62",
    "text": "རྒྱ་མཚོ་ཆེན་པོ་ཆུ་ཡི་གཏེར།"
  },
  {
    "id": "L00247",
    "index": 247,
    "context": "12883853653543f18782aee23995a89e",
    "text": "ཕུལ་གྱི་གཞལ་བར་ག་ལ་ནུས།"
  },
  {
    "id": "L00248",
    "index": 248,
    "context": "bde0b29ea1104c9899c8d4ea4b66b390",
    "text": "ཞེས་གསུངས་པ་ལྟར་དང་།"
  },
  {
    "id": "L00249",
    "index": 249,
    "context": "d2608c784d074a238e06630137e1f31c",
    "text": "རྒྱལ་པོ་མ་སྐྱེས་དགྲས་ཕ་བསད་པ་ཡང་དཀོན་མཆོག་ལ་སྐྱབས་སུ་སོང་བས་དམྱལ་བ་ཞག་བདུན་མྱོངས་ནས་ཐར་བར་གསུངས་པ་དང་།"
  },
  {
    "id": "L00250",
    "index": 250,
    "context": "ba72ae6c4e4d4b1192bd4ec6ed682919",
    "text": "ལྷས་སྦྱིན་མཚམས་མེད་པའི་ལས་གསུམ་བྱས་པས་གསོན་བཞིན་དུ་དམྱལ་བའི་མེས་སྲེག་པའི་ཚེ་སངས་རྒྱས་ཀྱི་གསུངས་ལ་ཡིད་ཆེས་ནས།"
  },
  {
    "id": "L00251",
    "index": 251,
    "context": "d5abab3781b740339e242fbdfb99bee3",
    "text": "ངས་ད་ནི་རུས་པའི་གཏིང་ནས་སངས་རྒྱས་ལ་སྐྱབས་སུ་མཆིའོ།"
  },
  {
    "id": "L00252",
    "index": 252,
    "context": "216400efb85c4ef98478fef841b4f91f",
    "text": "ཞེས་བརྗོད་པས་རང་སངས་རྒྱས་རུས་པ་ཅན་བྱ་བར་འགྱུར་བར་གསུངས་བ་ལྟ་བུ་ཡིན།"
  },
  {
    "id": "L00253",
    "index": 253,
    "context": "5947711e732c46f1ada37028f9729549",
    "text": "དེ་ལྟར་ཕན་ཡོན་ཚད་མེད་པ་དང་ལྡན་པས་ན་ཆོས་ཐམས་ཅད་ཀྱི་རྟེན་གཞི་སྐྱབས་སུ་འགྲོ་བའི་གནས་འདི་རྒན་གཞོན་ཆེ་ཆུང་བུ་དང་བུ་མོ་ཀུན་གྱི་ནན་ཏན་དུ་བྱ་དགོས་སོ།"
