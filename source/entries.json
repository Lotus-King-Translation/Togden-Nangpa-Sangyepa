[
  {
    "id": "L00001",
    "index": 1,
    "context": "37d15dbe1b4e4440a1df191c2ec820f3",
    "text": "ནང་པ་སངས་རྒྱས་པ་ཀུན་གྱི་ལམ་ཐམས་ཅད་ཀྱི་རྨིང་རྡོ་སྐྱབས་འགྲོའི་ཁྲིད་ཡིད་ཀྱི་མུན་སེལ་ཞེས་བྱ་བ་བཞུགས་སོ།།"
  },
  {
    "id": "L00002",
    "index": 2,
    "context": "d40549348530483880756974c7067ddf",
    "text": "ཕྱིའི་སྐྱབས་འགྲོ་མཆོག་གསུམ་ཐོད་བཞིན་ཁུར།"
  },
  {
    "id": "L00003",
    "index": 3,
    "context": "9fa7fd55077349a1bcd1561db2e5e4d6",
    "text": "ནང་གི་སྐྱབས་འགྲོ་རྩ་གསུམ་དངོས་སུ་གྲུབ།"
  },
  {
    "id": "L00004",
    "index": 4,
    "context": "33a43b9aa04548a1addc634c034a03bb",
    "text": "དོན་གྱི་སྐྱབས་འགྲོ་སྐུ་གསུམ་མངོན་དུ་བྱས།"
  },
  {
    "id": "L00005",
    "index": 5,
    "context": "a040c4ec64374a83bbdcfb189f0501a4",
    "text": "མཚུངས་མེད་བླ་མའི་ཞབས་ལ་ཕྱག་འཚལ་ལོ།"
  },
  {
    "id": "L00006",
    "index": 6,
    "context": "abd9131021754e90900a582ffcc3de7e",
    "text": "དང་པོ་ལམ་ཐམས་ཅད་ཀྱི་རྨིང་རྡོ་སྐྱབས་སུ་འགྲོ་བའི་ཁྲིད་ལ། སྐྱབས་འགྲོའི་དབྱེ་བ། སྐྱབས་སུ་འགྲོ་ཚུལ། བསླབ་བྱ་བསྟན་པ་དང་ཕན་ཡོན་བཅས་དོན་བཞི་རུ་བསྡུས་ཏེ་ཞུན།"
  },
  {
    "id": "L00007",
    "index": 7,
    "context": "addb4377847642feb1b6dab0c8aa30a3",
    "text": "དོན་དང་པོ། སྤྱིར་ཆོས་ཐམས་ཅད་ཀྱི་སྒོ་དབྱེ་བ་སྐྱབས་འགྲོ་ཡིན་ལ།"
  },
  {
    "id": "L00008",
    "index": 8,
    "context": "91f17515cd5e438bbba96af5e5f4abc9",
    "text": "སྐྱབས་འགྲོའི་སྒོ་དབྱེ་བ་ནི། དད་པ་ཡིན། སྐྱབས་སུ་འགྲོ་བའི་དང་པོར་རྒྱུད་ལ་དད་པ་བརྟན་པོ་སྐྱེ་པ་གལ་ཆེ།"
  },
  {
    "id": "L00009",
    "index": 9,
    "context": "98419b078c0044a990c8af32dc3775e4",
    "text": "དད་པ་དེ་ལ་ནང་གསེས་ཀྱིས་དབྱེ་གསུམ་ཡོད་དེ། དང་བའི་དད་པ། འདོད་པའི་དད་པ། ཡིད་ཆེས་པའི་དད་པ་དང་གསུམ་ཡོད།"
  },
  {
    "id": "L00010",
    "index": 10,
    "context": "93ca0e14e313413aa2928e14902c0e28",
    "text": "དང་པོ་དང་བའི་དད་པ་ཞེས་བྱ་བ་ནི། རྒྱལ་བའི་སྐུ་གསུང་ཐུགས་རྟེན་མང་པོ་ཡོད་པའི་གཙུག་ལག་ཁང་ལྟ་བུར་སྐྱོད་པའམ། བླ་མ་དགེ་བའི་བཤེས་གཉེན་སྐྱེས་བུ་དམ་པ་རྣམས་བཞུགས་པའི་ཞལ་མཇལ་ཞུ་བའམ།"
  },
  {
    "id": "L00011",
    "index": 11,
    "context": "0d842c2a2ccf447c8da0994745024dbc",
    "text": "དེ་དག་གི་ཡོན་ཏན་་་་་་་རྣམ་ཐར་ཐོས་པ་ལྟ་བུའི་རྐྱེན་གྱིས་བདག་ལ་ཐུགས་རྗེ་མ་ཆུང་སྙམ་དུ་སེམས་དང་བ་འདྲེན་ནས་དད་པ་སྐྱེས་པ་དེ་ལ་དང་བའི་དད་པ་ཞུ་བ་ཡིན་ནོ།"
  },
  {
    "id": "L00012",
    "index": 12,
    "context": "8861f9913eb24a8887e15e7846d2c332",
    "text": "གཉིས་པ་འདོད་པའི་དད་པ་ནི། འཁོར་བ་ངན་སོང་གི་སྡུག་བསྔོལ་ལ་སོགས་པ་ཐོས་ནས་དེ་དང་བྲལ་འདོད་སྐྱེ་བ།"
  },
  {
    "id": "L00013",
    "index": 13,
    "context": "91fbd82894e94f809507a1e87c26e77f",
    "text": "མཐོ་རིས་ལྷ་དང་མི་དད་ཐར་པའི་བདེ་སྐྱིད་ཐོས་ན་དེ་ལ་ཐོབ་འདོད་སྐྱེ་བ།"
  },
  {
    "id": "L00014",
    "index": 14,
    "context": "953fa724d94c4856b2563d32236d3dfb",
    "text": "དགེ་བའི་ཕན་ཡོན་ཐོས་ནས་དེ་ལ་སྒྲུབ་འདོད་དང་། སྡིག་པའི་ཉེས་པ་མཐོང་ནས་དེ་ལ་སྤང་འདོད་སྐྱེ་བ་རྣམས་ཡིན།"
  },
  {
    "id": "L00015",
    "index": 15,
    "context": "afa9c899277b432e86fa97e9f21974e4",
    "text": "གསུམ་པ་ཡིད་ཆེས་པའི་དད་པ་ནི། དཀོན་མཆོག་རིན་པོ་ཆེ་རྣམ་པ་གསུམ་གྱི་ཡོན་ཏན་དང་བྱིན་རླབས་ཐུན་མོང་མ་ཡིན་པ་ཤེས་ནས། སྐྱིད་རུང་སྡུག་རུང་ན་རུང་སྐྱེ་རུང་ཤི་རུང་གསོན་རུང་། ལས་ཅི་བྱུང་ཡང་སྐྱབས་བསླུ་བ་མེད་པ་དཀོན་མཆོག་གསུམ་པོ་མཁྱེན།"
  },
  {
    "id": "L00016",
    "index": 16,
    "context": "b16ddaeb5a054ff69ede0e6d94398bb8",
    "text": "བློ་གཏད་དང་རེ་ལྟོས་ཡིད་ཆེས་གཞན་ན་མེད་བསམ་པ་ལ་ཡིད་ཆེས་པའི་དད་པ་ཞུ་བ་ཡིན་ནོ།"
  },
  {
    "id": "L00017",
    "index": 17,
    "context": "a5f43c84c7dc43069db17899823b12d0",
    "text": "ཨོ་རྒྱན་རིན་པོ་ཆེའི་ཞལ་ནས།"
  },
  {
    "id": "L00018",
    "index": 18,
    "context": "d3d3b636f2e040d48041f9bbfed015d7",
    "text": "ཡིད་་་ཁྱེད་ཤེས་ཀྱི་དད་པས་བྱིན་རླབས་འདུག"
  },
  {
    "id": "L00019",
    "index": 19,
    "context": "c67a160f1a394352903c793ca8545e78",
    "text": "བློ་ཐེ་ཚོམ་དང་བྲལ་ན་ཅི་བསམ་འགྲུབ།"
  },
  {
    "id": "L00020",
    "index": 20,
    "context": "6454ff181caf4f9bb902dac082e50909",
    "text": "ཅེས་གསུངས་པ་བཞིན་ཡིན།"
  },
  {
    "id": "L00021",
    "index": 21,
    "context": "7ea98397255e4ed58e8639c13bff5bb5",
    "text": "དེས་ན་དད་པ་ནི་ཆོས་དཀར་པོའི་ཡོན་ཏན་ཐམས་ཅད་སྐྱེད་པའི་ས་བོན་ལྟ་བུ་ཡིན་པས། དད་པ་མེད་ན་ས་བོན་མེས་ཚིག་པ་དང་འདྲ་སྟེ།"
  },
  {
    "id": "L00022",
    "index": 22,
    "context": "b7806b66078742c2abaa0d28104c542c",
    "text": "མདོ་ལས།"
  },
  {
    "id": "L00023",
    "index": 23,
    "context": "7940164af1224af59f9396691d0d0d43",
    "text": "དད་པ་མེད་པའི་མི་རྣམས་ལ།"
  },
  {
    "id": "L00024",
    "index": 24,
    "context": "2e9a6242e9614853962382f6e4dc790b",
    "text": "དཀར་པོའི་ཆོས་ནི་མི་འབྱུང་སྟེ།"
  },
  {
    "id": "L00025",
    "index": 25,
    "context": "7d3423b0ee8d478ea45f30248cd2258d",
    "text": "ས་བོན་མེ་ཡིས་ཚིག་པ་ལ།"
  },
  {
    "id": "L00026",
    "index": 26,
    "context": "ae7eef6e1e6f469c97ebb9010697eccd",
    "text": "མྱུ་གུ་སྔོན་མོ་ཇི་བཞིན་ནོ།"
  },
  {
    "id": "L00027",
    "index": 27,
    "context": "8813a84d9dca4a93a01cc1e7be9efa2a",
    "text": "ཞེས་གསུངས།"
  },
  {
    "id": "L00028",
    "index": 28,
    "context": "fc34d78183804d6096121cee1ac813d4",
    "text": "དེ་བཞིན་དུ་དད་པ་ནི་འཕགས་པའི་ནོར་བདུན་གྱི་གཙོ་བོ་ཡིན་ཏེ། དད་པའི་འཁོར་ལོ་རིན་པོ་ཆེ། ཉིན་མཚན་དགེ་བའི་ལམ་ལ་སྦྱོར།"
  },
  {
    "id": "L00029",
    "index": 29,
    "context": "a6c2c3bd2bdb4e3eaecefbe3097f4eb6",
    "text": "ཞེས་པ་ལྟར་ཡིན་པས་ནོར་ཐམས་ཅད་ཀྱི་ནང་ན་མཆོག་ཏུ་གྱུར་པ་ཡིན་པ་དང་དེ་བཞིན་དུ་ཡོན་ཏན་མི་ཟད་པའི་འབྱུང་གནས་ཡིན་པས་གཏེར་དང་། ཐར་པའི་ལམ་དུ་འགྲོ་བའི་རྐང་པ་དང། དགེ་བའི་ཆོས་ཐམས་ཅད་རང་རྒྱུད་ལ་སྡུད་པའི་ལག་པ་ལྟ་བུ་ཡིན་ཏེ།"
  },
  {
    "id": "L00030",
    "index": 30,
    "context": "29c1bffd6457414f81088c394ee6d02b",
    "text": "དད་པ་ནོར་དང་གཏེར་དང་རྐང་པའི་མཆོག ལག་པ་བཞིན་དུ་དགེ་སྡུས་རྩ་བ་ཡིན། ཞེས་གསུངས།"
  },
  {
    "id": "L00031",
    "index": 31,
    "context": "ffb1bf64b5474fa3b2b7458f36644bcc",
    "text": "དེས་ན་དཀོན་མཆོག་གསུམ་ལ་ཐུགས་རྗེ་དང་བྱིན་རླབས་བསམ་གྱི་མི་ཁྱབ་པ་ཡོད་ཀྱང་། རང་གི་རྒྱུད་ལ་འཇུག་པར་བྱེད་པ་ནི་དད་པ་དང་མོས་གུས་གཉིས་ཁག་ཆེ་ཡིན།"
  },
  {
    "id": "L00032",
    "index": 32,
    "context": "09f1d9c8f81a4faf9bd00a57e63e8017",
    "text": "རང་ལ་དད་པ་དང་མོས་གུས་ལེགས་པ་ཅིག་ཡོད་ན་བླ་མ་དཀོན་མཆོག་གི་ཐུགས་རྗེ་དང་བྱིན་རླབས་ཡང་ལེགས་པ་ཅིག་ཡོང་།"
  },
  {
    "id": "L00033",
    "index": 33,
    "context": "250aeacd6a784debaa4d94824ea523d2",
    "text": "འབྲིང་འབྲིང་། ཉུང་ངུ་ལ་ཉུང་ངུ་། དད་པ་དང་མོས་གུས་རྩ་བ་ནས་མེད་ན་བྱིན་རླབས་དང་ཐུགས་གཏན་ནས་མི་འཇུག་པ་ཡིན།"
  },
  {
    "id": "L00034",
    "index": 34,
    "context": "ee34a4baa16f45bc87d9d18fafcfa461",
    "text": "དཔེར་ན་དགེ་སློང་ལེགས་པའི་སྐར་མ་ལོ་ཉེར་ལྔའི་བར་དུ་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་འབྲིང་དུ་བསྡད་ཀྱང་དད་པ་ཅུང་ཟད་མེད་པར་ལོག་ལྟ་ཁོ་ན་བྱས་པས་མཐར་མེ་ཏོག་ལྡུམ་རར་ཡི་དྭགས་སུ་སྐྱས་པ་ལྟ་བུ་ཡིན།"
  },
  {
    "id": "L00035",
    "index": 35,
    "context": "c5d6d09e859c4f208e8acd1cee8537d3",
    "text": "སངས་རྒྱས་མདུན་དུ་ཕེབས་ཀྱང་དད་པ་ཅུང་ཟད་མེད། དུད་འགྲོ་རྒྱུ་མ་རླུག་ཀྱང་སྙིང་རྗེ་ཅུང་ཟད་མེད། དེ་གཉིས་མེད་ལ་བྱིན་རླབས་ག་ལ་འཇུག ཞེས་པ་ལྟར་ཡིན།"
  },
  {
    "id": "L00036",
    "index": 36,
    "context": "bd75441e2612490aae6d24467ac63165",
    "text": "སྙིང་ཁོང་རུས་པའི་གཏིང་ནས་དད་པ་དང་མོས་གུས་ཡོད་ན་དེའི་དྲུང་ན་རྒྱལ་བ་རྫོགས་པའི་སངས་རྒྱས་ཉིད་བཞུགས་ནས་བྱིན་གྱིས་རློབ་པར་འགྱུར་བ་ཡིན་པས།"
  },
  {
    "id": "L00037",
    "index": 37,
    "context": "8a77bc068b5847d7a1460c49ff829588",
    "text": "ཇི་སྐད་དུ།"
  },
  {
    "id": "L00038",
    "index": 38,
    "context": "0f238159a301452f86a3040672bef2ec",
    "text": "གང་གིས་མོས་པ་ཡིད་བྱེད་པ།"
  },
  {
    "id": "L00039",
    "index": 39,
    "context": "c999df2e86e744d0a9fd3ce4bcbf731e",
    "text": "དེ་ཡི་མདུན་དུ་ཐུབ་པ་བཞུགས།"
  },
  {
    "id": "L00040",
    "index": 40,
    "context": "cef765319e0841debed505138a357be7",
    "text": "དབང་བསྐུར་བྱིན་གྱིས་བརླབ་པར་འགྱུར།།"
  },
  {
    "id": "L00041",
    "index": 41,
    "context": "91a0fe45b48641bf968b7380d3869b8c",
    "text": "ཞེས་དང་། གུ་རུ་རིན་པོ་ཆེས།"
  },
  {
    "id": "L00042",
    "index": 42,
    "context": "d6da72e7487144f388d259d1cf6deef2",
    "text": "དད་པ་ཅན་གྱི་གང་ཟག་ཕོ་མོ་ལ།"
  },
  {
    "id": "L00043",
    "index": 43,
    "context": "760ad0447d484620940dbdaed814b772",
    "text": "པད་འབྱུང་གང་དུའང་མ་བཞུད་སྒོ་ཉལ་ཡོད།"
  },
  {
    "id": "L00044",
    "index": 44,
    "context": "2bcbd6c3ad83445091fdcc5c0fb96fc1",
    "text": "ང་ཡི་ཚེ་ལ་འདས་གྲོང་ཡོད་མ་ཡིན།"
  },
  {
    "id": "L00045",
    "index": 45,
    "context": "9b2b810c59fa4a73890d6508aa6589ba",
    "text": "དད་ལྡན་མི་རེའི་མདུན་ན་པད་འབྱུང་རེ།"
  },
  {
    "id": "L00046",
    "index": 46,
    "context": "4599654d9f9f4986b85cbb474aefe5b2",
    "text": "རང་ལ་ཡིད་ཆེས་ཀྱི་དད་པ་ཡོད་ན་སངས་རྒྱས་ཀྱི་ཐུགས་རྗེ་གང་དུ་ཡང་འཇུག་པ།"
  },
  {
    "id": "L00047",
    "index": 47,
    "context": "3566e6049f2d4496b69637a708f5a2ac",
    "text": "དད་པ་ཡོད་ན་རྒན་མོ་ཁྱི་སོས་སངས་རྒྱས་ཟེར་བ་ཡིན་ཏེ།"
  },
  {
    "id": "L00048",
    "index": 48,
    "context": "003aa02a1a8a4be8bf41418019fec23a",
    "text": "སྔོན་དུས་རྒན་མོ་མ་བུ་གཉིས་ཡོད་པ་ཡིན།"
  },
  {
    "id": "L00049",
    "index": 49,
    "context": "6d327e8af390478487e06168bd3a2732",
    "text": "བུ་ཡང་་་་་ཡང་རྒྱ་གར་དུ་ཚོང་ལ་འགྲོ་བ་ཞིག་ཡོད།"
  },
  {
    "id": "L00050",
    "index": 50,
    "context": "4bc701146f154a499af188b1d876d166",
    "text": "བུ་རང་ལ་མ༼་༽རྒན་ང་ཡིས་ཞུ་བ་ཡིན།"
  },
  {
    "id": "L00051",
    "index": 51,
    "context": "2e4c99797286449f91130df6cdd23c6b",
    "text": "རྒྱ་གར་འཕགས་ཡུལ་གྱི་གནས་ཆེན་རྡོ་རྗེ་གདན་རྫོགས་པའི་སངས་རྒྱས་མང་དུ་བྱོན་པའི་ཡུལ་ཡིན་པར་འདུག་པས།"
  },
  {
    "id": "L00052",
    "index": 52,
    "context": "cef9a64fc9b84831a584328ed3d20a1f",
    "text": "ཁྱོད་ཀྱིས་རྒྱ་གར་ནས་ང་ལ་ཕྱག་འཚལ་བའི་རྟེན་ཁྱད་པར་ཅན་ཞིག་ཞུ་དགོས།"
  },
  {
    "id": "L00053",
    "index": 53,
    "context": "1077a726fd1049968a126978863cedac",
    "text": "ཅེས་ལན་མང་པོར་ཟེར་ཡང་བུས་བརྗེད་ནས་རྟེན་མ་ལོན།"
  },
  {
    "id": "L00054",
    "index": 54,
    "context": "138b1e24a6b94a4b896fed2494e6778f",
    "text": "སྐོར་ཅིག་ཡང་བུ་རྒྱ་གར་དུ་འགྲོ་བའི་ཚེ་"
  },
  {
    "id": "L00055",
    "index": 55,
    "context": "97efee7d32e64c559d4823ed0f2f3ae7",
    "text": "ད་རེས་ང་ལ་ཕྱག་འཚལ་བའི་རྟེན་ཞིག་འཁུར་རྒྱུ་མེད་ན་ང་ཁྱོད་རང་གི་སྔོན་ལ་ལྕེབས་ནས་འཆིའོ་ཟེར་བ་ལ།"
  },
  {
    "id": "L00056",
    "index": 56,
    "context": "4c7ad08de94c4423890272a7a2629d4c",
    "text": "བུ་རྒྱ་གར་དུ་ཕྱིན་ཚོང་བྱས་ནས་སླར་ལྡོག་གི་བར་དུ་བརྗེད།"
  },
  {
    "id": "L00057",
    "index": 57,
    "context": "0c9faea372e04003a8b36d52a788ed58",
    "text": "ཁང་པར་སླེབ་པར་མས་སྨྲས་པ་དྲན་ནས།"
  },
  {
    "id": "L00058",
    "index": 58,
    "context": "2fb538af2b744688b4eed63ec6a8f04a",
    "text": "ད་ཅི་བྱེད་ངས་མ་རྒན་ལ་ཕྱག་འཚལ་བའི་རྟེན་ནི་མ་ལོན།"
  },
  {
    "id": "L00059",
    "index": 59,
    "context": "2f3c8cb5221a4ee797aecedb14ce467d",
    "text": "ད་མ་རྒན་ལྕབས་ནས་འཆི་སྙམ་སྟེ།"
  },
  {
    "id": "L00060",
    "index": 60,
    "context": "1ea1edae6c10409291ecfdb3cb0d574b",
    "text": "གཡས་གཡོན་དུ་བལྟས་པས་ཟུར་ཞིག་ན་ཁྱི་མགོ་ཞིག་འདུག"
  },
  {
    "id": "L00061",
    "index": 61,
    "context": "2195ba573887451db0a56fbfce1086ce",
    "text": "དེའི་སོ་ཞིག་པུད་ནས་དར་གྱིས་དྲིལ་ཏེ་ཁྱེར་འོངས་ནས་མ་ལ་བྱིན།"
  },
  {
    "id": "L00062",
    "index": 62,
    "context": "b273c8b959964bcbb16129636b319b86",
    "text": "འདི་བཅོམ་ལྡན་འདས་ཀྱི་ཚེམས་མཆེ་བ་ཡིན་པས་མ་རྒན་ཁྱོད་ཀྱིས་གསོལ་བ་འདེབས་པའི་རྟེན་གྱིས་ཤིག་བྱས་པས།"
  },
  {
    "id": "L00063",
    "index": 63,
    "context": "aa2cb4fd633d4a269db6f4d7594fc3ae",
    "text": "མ་རྒན་གྱིས་ཁྱི་སོ་དེ་ལ་སངས་རྒྱས་ཀྱི་ཚེམས་དངོས་སུ་བཟུང་ནས་དད་པ་བསྐྱད་དེ་དུས་རྒྱུན་དུ་ཕྱག་དང་མཆོད་པ་བྱས་པས་ཁྱི་སོ་ལས་རིང་བསྲེལ་མང་པོ་བབས།"
  },
  {
    "id": "L00064",
    "index": 64,
    "context": "6e42fb3379f6469194f75762e5b023c2",
    "text": "རྒན་མོ་འཆི་བའི་ཚེ་འཇའ་འོད་ཀྱི་གུར་ཕུབ་པ་སོགས་བྱུང་བ་ཡིན།"
  },
  {
    "id": "L00065",
    "index": 65,
    "context": "c9ed991106c349d4b7066e1b214de91b",
    "text": "ཁྱི་སོ་ལ་བྱིན་རླབས་ཡོད་པ་མ་ཡིན་ཀྱང་། རྒན་མོ་དད་པ་ཆེ་བའི་སྟོབས་ཀྱིས་སངས་རྒྱས་ཀྱི་བྱིན་རླབས་ཁྱི་སོ་ལ་ཞུགས་ཏེ་སངས་རྒྱས་ཚེམས་དང་ཁྱད་མ་བྱུང་བ་ཡིན།"
  },
  {
    "id": "L00066",
    "index": 66,
    "context": "43761322d14d40f990f6b2d8cbf1e21a",
    "text": "དེར་མ་ཟད་གནས་ལུགས་དོན་དམ་པའི་བདེན་པ་མངོན་སུམ་དུ་རྟོགས་པ་ཡང་དད་པ་ཁོ་ན་ལ་རགས་ལས་ཏེ།"
  },
  {
    "id": "L00067",
    "index": 67,
    "context": "10bb545984264ff79403b30406c8e2c4",
    "text": "མདོ་ལས་ཀྱང་།"
  },
  {
    "id": "L00068",
    "index": 68,
    "context": "579b41d98369439d98d43e29686c0819",
    "text": "ཤཱ་རིའི་བུ་དོན་དམ་པ་ནི་དད་པས་རྟོགས་པར་བྱ་བ་ཁོ་ན་ཡིན་ནོ་གསུངས།"
  },
  {
    "id": "L00069",
    "index": 69,
    "context": "c93bd80ab1074aef827feae394e65eaf",
    "text": "དད་པ་ཐུན་མོང་མ་ཡིན་པ་སྐྱེས་པའི་མཐུ་ལས་བླ་མ་དཀོན་མཆོག་གི་བྱིན་རླབས་རང་རྒྱུད་ལ་ཞུགས་ནས་ཡང་དག་པའི་རྟོགས་པ་རྒྱུད་ལ་སྐྱེ་ཞིང་གནས་ལུགས་ཡང་དག་པའི་དོན་མཐོང་ཚེ་བླ་མ་དང་དཀོན་མཆོག་ལ་ཡིད་ཆེས་པ་གཅིག"
  },
  {
    "id": "L00070",
    "index": 70,
    "context": "b59461d10faa4c97936810f2af10eb3c",
    "text": "ཕྱིར་མི་ལྡོག་པའི་དད་པ་ཐུན་མོང་མ་ཡིན་པ་སྐྱེ་བས་གནས་ལུགས་ཀྱི་རྟོགས་པ་དང་ཡིད་ཆེས་ཀྱི་དད་པ་གཉིས་གཅིག་གྲོགས་གཅིག་གིས་བྱེད་པ་ཡིན་ཏེ།"
  },
  {
    "id": "L00071",
    "index": 71,
    "context": "1cdf80c51ed44aadb10ec18932c63c57",
    "text": "སྔོན་དྭགས་པའི་རིན་པོ་ཆེ་བྱོན་ཁར་རྗེ་བཙུན་མི་ལ་རིན་པོ་ཆེ་ལ་ཚོགས་པ་སྐྱོང་བའི་དུས་ནམ་ཡིན་ཞུས་པས།"
  },
  {
    "id": "L00072",
    "index": 72,
    "context": "4a5c8bdb9c854d5fb4347fbabc28cf61",
    "text": "ཇི་ཞིག་ན་ད་ལྟ་དང་མི་འདྲ་བའི་སེམས་ཀྱི་ངོ་བོ་ལྷག་གིས་མཐོང་བའི་རྟོགས་པ་ཞིག་རྒྱུད་ལ་སྐྱེ།"
  },
  {
    "id": "L00073",
    "index": 73,
    "context": "6b86a20c64814caaa0fd6167d3c733ab",
    "text": "དེའི་དུས་སུ་ཕ་རྒན་ང་ལ་ཡང་སངས་རྒྱས་དངོས་སུ་མཐོང་བའི་དད་པ་བརྟན་པོ་སྐྱེ་བ་ཡིན་པས་དེ་དུས་ཚོགས་པ་སྐྱོངས་གསུངས་པ་ཡིན།"
  },
  {
    "id": "L00074",
    "index": 74,
    "context": "5855ec718bc94483b5770018b7318057",
    "text": "དེ་ལྟར་དད་པ་དང་མོས་གུས་ཐུན་མོང་མ་ཡིན་པ་ཞིག་གི་སྒོ་ནས་ཡིད་ཁྱེད་ཤེས་ཀྱི་བློ་གཞན་དུ་མི་འགྱུར་བ་ཞིག་ནི། སྐྱབས་སུ་འགྲོ་བའི་སྒོ་འབྱེད་ལྟ་བུ་ཡིན་པས་མེད་ཐབས་མེད།"
  },
  {
    "id": "L00075",
    "index": 75,
    "context": "b17416dcdf314d8f9ab25ea6f6cf0403",
    "text": "དེ་ལྟ་བུའི་དད་པ་དང་ལྡན་པའི་སྐྱབས་འགྲོ་དེ་ལ་ཡང་། ཀུན་སློང་གི་སྒོ་ནས་དབྱེ་ན་གསུམ་སྟེ།"
  },
  {
    "id": "L00076",
    "index": 76,
    "context": "a80b5e51a5184c87878ccab18024efe2",
    "text": "འདི་ལྟར་དམྱལ་བ་ཡི་དྭགས་དུད་འགྲོ་སྟེ།"
  },
  {
    "id": "L00077",
    "index": 77,
    "context": "64fd79bb7ed84515aa38e59f06d34332",
    "text": "ངན་སོང་གསུམ་གྱི་སྡུག་བསྔལ་ལ་འཇིགས་ཤིང་སྐྲག་ནས་མཐོ་རིས་ལྷ་དང་མིའི་བདེ་བ་ཙམ་དོན་དུ་གཉེར་བས་སྐྱབས་སུ་འགྲོ་ན། སྐྱེས་བུ་ཆུང་ངུའི་སྐྱབས་འགྲོ་ཞེས་བྱ།"
  },
  {
    "id": "L00078",
    "index": 78,
    "context": "b5eb0b865a084aa8b420e0c09ca49a2d",
    "text": "འཁོར་བའི་གནས་རིས་འདི་མཐོ་དམན་གང་དུ་སྐྱེས་ཀྱང་སྡུག་བསྔལ་གྱི་རང་བཞིན་ལས་མ་འདས་པར་ཤེས་ནས།"
  },
  {
    "id": "L00079",
    "index": 79,
    "context": "225409bb552a49acacb3890b6da22cc9",
    "text": "རང་ཉིད་འཁོར་བའི་སྡུག་བསྔལ་ཐམས་ཅད་ལས་གྲོལ་བའི་ཞི་བ་མྱང་འདས་ཀྱི་གོ་འཕང་ཙམ་དོན་དུ་གཉེར་ནས། དཀོན་མཆོག་གསུམ་ལ་སྐྱབས་སུ་འགྲོ་ན་སྐྱེས་བུ་འབྲིང་གི་སྐྱབས་འགྲོ་ཞེས་བྱ།"
  },
  {
    "id": "L00080",
    "index": 80,
    "context": "3f8173ef486649a0a724a5e0fd717ecf",
    "text": "མཐའ་མེད་པའི་འཁོར་བ་སྡུག་བསྔལ་གྱི་རྒྱ་མཚོ་ཆེན་པོ་ན་གནས་པའི་སེམས་ཅན་འདི་དག་ཐམས་ཅད་སྡུག་བསྔལ་གྱི་རྣམ་གྲངས་བསམ་གྱིས་མི་ཁྱབ་པས་མནར་བར་མཐོང་ནས།"
  },
  {
    "id": "L00081",
    "index": 81,
    "context": "24d2d6595831491594616eb015892ede",
    "text": "དེ་ཐམས་ཅད་རྣམ་མཁྱེན་བླ་མ་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་སངས་རྒྱས་ཀྱི་གོ་འཕང་ལ་འགོད་པའི་ཆེད་དུ་སྐྱབས་སུ་འགྲོ་ན་སྐྱེས་བུ་ཆེན་པོའི་སྐྱབས་འགྲོ་ཞེས་བྱ།"
  },
  {
    "id": "L00082",
    "index": 82,
    "context": "b8301c3e878a45b2aeb611a1afe9ced2",
    "text": "དེ་ལྟར་སེམས་ཀྱི་ཀུན་སློང་རྣམ་པ་གསུམ་ལས་ད་རེས་ཀྱི་སྐབས་སུ་མཐའ་ཡས་པའི་སེམས་ཅན་ཐམས་ཅད་རྫོགས་པའི་སངས་རྒྱས་ཀྱི་གོ་འཕང་ལ་འགོད་པར་འདོད་པའི་སྐྱེས་བུ་ཆེན་པོའི་སྐྱབས་སུ་འགྲོ་དགོས་ཏེ།"
  },
  {
    "id": "L00083",
    "index": 83,
    "context": "27eeba9f83c54e3197ef4d2b3293e004",
    "text": "མཐོ་རིས་ལྷ་དང་མིའི་བདེ་བ་ཙམ་ནི་འཕྲལ་དུ་བདེ་བ་ལྟར་སྣང་ཡང་དོན་དུ་སྡུག་བསྔལ་ལས་མ་འདས་ཤིང་མཐོ་རིས་ཀྱི་བདེ་འབྲས་ཟད་ནས་སླར་ཡང་ངན་སོང་དུ་ལྟུང་བར་འགྱུར་བས།"
  },
  {
    "id": "L00084",
    "index": 84,
    "context": "be810badf75d40aa8a7ac84df123184a",
    "text": "མཐོ་རིས་ཀྱི་བདེ་བ་དར་ཅིག་ཙམ་པ་དོན་དུ་གཉེར་བ་ལ་དགོས་པ་མེད།"
  },
  {
    "id": "L00085",
    "index": 85,
    "context": "47f79f157e0b402f920f4f05f6ac63d7",
    "text": "རང་ཉིད་གཅིག་པུ་ཞི་བདེ་མྱ་ངན་ལས་འདས་པ་ཉན་ཐོས་དང་རང་སངས་རྒྱས་ཀྱི་གོ་འཕང་ཙམ་ཐོབ་ཀྱང་ཐོག་མ་མེད་པའི་དུས་ནས་རང་གི་ཨ་ཕ་ཨ་མར་གྱུར་པའི་སེམས་ཅན་རྣམས་མཐའ་མེད་འཁོར་བ་སྡུག་བསྔལ་གྱི་རྒྱ་མཚོར་ལྷུངས་པ་རྣམས་ཀྱི་དོན་མ་བྱས་པར་གྱུར་ན་མི་རུང་བས།"
  },
  {
    "id": "L00086",
    "index": 86,
    "context": "9363acd97a714491a5526c17b08dda73",
    "text": "སེམས་ཅན་ཐམས་ཅད་སངས་རྒྱས་ཀྱི་གོ་འཕང་ཐོབ་པར་འདོད་པས་དཀོན་མཆོག་གསུམ་ལ་སྐྱབས་སུ་འགྲོ་བ་ནི། སྐྱེས་བུ་ཆེན་པོའི་ལམ་བསོད་ནམས་ཚད་མེད་པའི་འཇུག་ངོགས་ཡིན་པས་དེ་ལྟ་བུ་ལ་བསྟེན་དགོས་ཏེ།"
  },
  {
    "id": "L00087",
    "index": 87,
    "context": "c1d5e23f648847f9919be5853b2b70ac",
    "text": "རིན་ཆེན་ཕྲེང་བ་ལས།"
